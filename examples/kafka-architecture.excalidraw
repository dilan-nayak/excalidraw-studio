      "text": "const { Kafka } = require('kafkajs');\n\nconst kafka = new Kafka({\n  clientId: 'checkout-service',\n  brokers: ['localhost:9092'],     // where the cluster is\n});\nconst producer = kafka.producer();\n\nasync function run() {                 \n  await producer.connect();\n  await producer.send({\n    topic: 'orders',\n    acks: -1,                      // wait for all in-sync replicas\n    messages: [{\n      key: 'user-42',              // same key -> same partition\n      value: JSON.stringify({ orderId: 1001, total: 59.9 }),\n    }],\n  });\n  await producer.disconnect();\n}\nrun().catch(console.error);",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const { Kafka } = require('kafkajs');\n\nconst kafka = new Kafka({\n  clientId: 'checkout-service',\n  brokers: ['localhost:9092'],     // where the cluster is\n});\nconst producer = kafka.producer();\n\nasync function run() {                 \n  await producer.connect();\n  await producer.send({\n    topic: 'orders',\n    acks: -1,                      // wait for all in-sync replicas\n    messages: [{\n      key: 'user-42',              // same key -> same partition\n      value: JSON.stringify({ orderId: 1001, total: 59.9 }),\n    }],\n  });\n  await producer.disconnect();\n}\nrun().catch(console.error);",
      "autoResize": true,
      "lineHeight": 1.2
    },
