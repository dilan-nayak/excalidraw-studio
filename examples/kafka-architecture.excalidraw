      "containerId": null,
      "originalText": "Glossary",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "m-GklYsSJZTK_e-dIUJCK",
      "type": "text",
      "x": 24,
      "y": 3016,
      "width": 544.921875,
      "height": 252,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0o",
      "roundness": null,
      "seed": 2019510621,
      "version": 3,
      "versionNonce": 749593597,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795582760742,
      "link": null,
      "locked": false,
      "text": "Broker      A Kafka server. Stores partitions, serves clients.\nCluster     A group of brokers working together.\nTopic       A named stream of events, e.g. 'orders'.\nPartition   One ordered, append-only log inside a topic.\nOffset      An event's position number in its partition.\nProducer    App that writes events to a topic.\nConsumer    App that reads events from a topic.\nGroup       Consumers that share the work. Each partition\n            goes to exactly ONE member of the group.\nReplica     A copy of a partition on another broker.\nLeader      The replica that handles reads and writes.\nISR         In-Sync Replicas: followers fully caught up.\nController  Broker role (KRaft) that manages cluster state.\nRetention   How long events are kept (e.g. 7 days).",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Broker      A Kafka server. Stores partitions, serves clients.\nCluster     A group of brokers working together.\nTopic       A named stream of events, e.g. 'orders'.\nPartition   One ordered, append-only log inside a topic.\nOffset      An event's position number in its partition.\nProducer    App that writes events to a topic.\nConsumer    App that reads events from a topic.\nGroup       Consumers that share the work. Each partition\n            goes to exactly ONE member of the group.\nReplica     A copy of a partition on another broker.\nLeader      The replica that handles reads and writes.\nISR         In-Sync Replicas: followers fully caught up.\nController  Broker role (KRaft) that manages cluster state.\nRetention   How long events are kept (e.g. 7 days).",
      "autoResize": true,
      "lineHeight": 1.2
    },
