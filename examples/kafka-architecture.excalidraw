    {
      "id": "-IO1piKPPp0UWQVwuE2zw",
      "type": "text",
      "x": 1544,
      "y": 2150,
      "width": 309.2156982421875,
      "height": 340,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0U",
      "roundness": null,
      "seed": 266082237,
      "version": 3,
      "versionNonce": 789408061,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795582754626,
      "link": null,
      "locked": false,
      "text": "PRODUCER\n  connect() then send()\n  topic    = which stream\n  key      = decides the partition\n  acks=-1  = wait for all replicas\n\nCONSUMER\n  subscribe() then run()\n  groupId  = which group (shares work)\n  eachMessage = your handler\n  offset is committed after it returns\n\nTRY IT: start two consumers with the\nsame groupId and watch Kafka split\nthe partitions between them. Use a\ndifferent groupId and it gets its own\nfull copy of every event.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PRODUCER\n  connect() then send()\n  topic    = which stream\n  key      = decides the partition\n  acks=-1  = wait for all replicas\n\nCONSUMER\n  subscribe() then run()\n  groupId  = which group (shares work)\n  eachMessage = your handler\n  offset is committed after it returns\n\nTRY IT: start two consumers with the\nsame groupId and watch Kafka split\nthe partitions between them. Use a\ndifferent groupId and it gets its own\nfull copy of every event.",
      "autoResize": true,
      "lineHeight": 1.25
    },
