      "updated": 1795582686477,
      "link": null,
      "locked": false,
      "text": "Legend:  green = LEADER partition (serves reads & writes)  |  grey = REPLICA (backup copy on another broker)\norange = controller (manages the cluster)   |   P0, P1, P2 = partitions of the topic \"orders\"",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Legend:  green = LEADER partition (serves reads & writes)  |  grey = REPLICA (backup copy on another broker)\norange = controller (manages the cluster)   |   P0, P1, P2 = partitions of the topic \"orders\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
