      "updated": 1795582659883,
      "link": null,
      "locked": false,
      "text": "2. Why use it?",
      "fontSize": 26,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Why use it?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oky8LIz5c1xtpSLyOvO-c",
      "type": "text",
      "x": 784,
      "y": 190,
      "width": 488.5556945800781,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 841638547,
      "version": 2,
      "versionNonce": 108646909,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795582659883,
      "link": null,
      "locked": false,
      "text": "• Decouples services: the sender never needs to know\n  who will read the event\n• Handles millions of events per second\n• Survives failures: data is copied to several brokers\n• Scales out: add brokers, partitions or consumers\n• Replay: re-read old events to fix bugs or rebuild data\n• Order is guaranteed inside one partition",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Decouples services: the sender never needs to know\n  who will read the event\n• Handles millions of events per second\n• Survives failures: data is copied to several brokers\n• Scales out: add brokers, partitions or consumers\n• Replay: re-read old events to fix bugs or rebuild data\n• Order is guaranteed inside one partition",
      "autoResize": true,
      "lineHeight": 1.25
    },
