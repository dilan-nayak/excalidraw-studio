      "text": "Quick start: run it on your own PC (needs Docker and Node.js)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Quick start: run it on your own PC (needs Docker and Node.js)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "J9rI2tV00-msHq2Vt8x-S",
      "type": "text",
      "x": 24,
      "y": 2634,
      "width": 451.1240234375,
      "height": 184.8,
      "angle": 0,
      "strokeColor": "#e9ecef",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0X",
      "roundness": null,
      "seed": 1915143219,
      "version": 3,
      "versionNonce": 83393203,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795582754626,
      "link": null,
      "locked": false,
      "text": "# 1. Start one Kafka broker (KRaft mode, no ZooKeeper needed)\ndocker run -d --name kafka -p 9092:9092 apache/kafka:latest\n\n# 2. Create the topic with 3 partitions\ndocker exec kafka /opt/kafka/bin/kafka-topics.sh --create --topic orders \\\n   --partitions 3 --bootstrap-server localhost:9092\n\n# 3. Install the client, then run in two terminals\nnpm install kafkajs\nnode consumer.js        # terminal 1: waits for orders\nnode producer.js        # terminal 2: sends one, terminal 1 prints it",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# 1. Start one Kafka broker (KRaft mode, no ZooKeeper needed)\ndocker run -d --name kafka -p 9092:9092 apache/kafka:latest\n\n# 2. Create the topic with 3 partitions\ndocker exec kafka /opt/kafka/bin/kafka-topics.sh --create --topic orders \\\n   --partitions 3 --bootstrap-server localhost:9092\n\n# 3. Install the client, then run in two terminals\nnpm install kafkajs\nnode consumer.js        # terminal 1: waits for orders\nnode producer.js        # terminal 2: sends one, terminal 1 prints it",
      "autoResize": true,
      "lineHeight": 1.2
    },
