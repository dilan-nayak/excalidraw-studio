    {
      "id": "50z07fQR8q4RaCp7cHQrG",
      "type": "text",
      "x": 0,
      "y": 1430,
      "width": 964.8292846679688,
      "height": 37.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "asW",
      "roundness": null,
      "seed": 1443104573,
      "version": 3,
      "versionNonce": 1709654141,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795582713067,
      "link": null,
      "locked": false,
      "text": "grey = already read and committed   |   purple = next event this consumer group will read   |   white = newer events\nNumbers are OFFSETS. Each partition has its own numbering, and the group's progress (committed offset) is tracked per partition.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "grey = already read and committed   |   purple = next event this consumer group will read   |   white = newer events\nNumbers are OFFSETS. Each partition has its own numbering, and the group's progress (committed offset) is tracked per partition.",
      "autoResize": true,
      "lineHeight": 1.25
    },
