      "updated": 1795582659883,
      "link": null,
      "locked": false,
      "text": "1. What is Kafka?",
      "fontSize": 26,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. What is Kafka?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_yCCVZ_35GDQMyWo5q4xh",
      "type": "text",
      "x": 24,
      "y": 190,
      "width": 562.6436767578125,
      "height": 202.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 1074493277,
      "version": 2,
      "versionNonce": 907477267,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795582659883,
      "link": null,
      "locked": false,
      "text": "Kafka is a distributed event-streaming platform. Think of it as\na very fast, durable, shared LOG that many programs can write\nto and read from at the same time.\n\n• An event = one small record: a key, a value and a timestamp.\n• Producers APPEND events. Consumers READ them, in order.\n• Events stay on disk for days (or forever). Reading does NOT\n  delete them, so many readers can replay them any time.\n• It runs as a cluster of servers called BROKERS.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Kafka is a distributed event-streaming platform. Think of it as\na very fast, durable, shared LOG that many programs can write\nto and read from at the same time.\n\n• An event = one small record: a key, a value and a timestamp.\n• Producers APPEND events. Consumers READ them, in order.\n• Events stay on disk for days (or forever). Reading does NOT\n  delete them, so many readers can replay them any time.\n• It runs as a cluster of servers called BROKERS.",
      "autoResize": true,
      "lineHeight": 1.25
    },
