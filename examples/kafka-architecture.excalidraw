    {
      "id": "THbdXTH-Ey8n79ckqkxgC",
      "type": "text",
      "x": 924,
      "y": 1192,
      "width": 213.88389587402344,
      "height": 27.5,
      "angle": 0,
      "strokeColor": "#0b7285",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
