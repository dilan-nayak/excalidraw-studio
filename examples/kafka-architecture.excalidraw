    },
    {
      "id": "tXXTAI82FpajjAYXvOG8l",
      "type": "text",
      "x": 1384,
      "y": 190,
      "width": 505.8717041015625,
      "height": 202.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 16021629,
      "version": 2,
      "versionNonce": 2074187251,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795582659883,
      "link": null,
      "locked": false,
      "text": "Checkout service  --publishes-->  topic 'orders'\n\n   Payment service     reads it  (group: payments)\n   Email service       reads it  (group: emails)\n   Analytics           reads it  (group: analytics)\n\nEach service gets its OWN copy of every order and reads\nat its own speed. If Email is down for an hour, it simply\ncatches up later. No order is lost.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Checkout service  --publishes-->  topic 'orders'\n\n   Payment service     reads it  (group: payments)\n   Email service       reads it  (group: emails)\n   Analytics           reads it  (group: analytics)\n\nEach service gets its OWN copy of every order and reads\nat its own speed. If Email is down for an hour, it simply\ncatches up later. No order is lost.",
      "autoResize": true,
      "lineHeight": 1.25
    },
