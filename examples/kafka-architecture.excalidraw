    },
    {
      "id": "GtKn6wQq6CU8GitxD9i29",
      "type": "text",
      "x": 1044,
      "y": 3016,
      "width": 544.921875,
      "height": 252,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0r",
      "roundness": null,
      "seed": 2092626067,
      "version": 3,
      "versionNonce": 922608627,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795582760742,
      "link": null,
      "locked": false,
      "text": "acks=0     fire and forget (fastest, can lose data)\nacks=1     leader confirms (lost if leader dies first)\nacks=all   every in-sync replica confirms (safest)\n\nAt-most-once    commit the offset BEFORE processing\nAt-least-once   commit AFTER processing (the default).\n                Duplicates possible: make handlers idempotent.\nExactly-once    idempotent producer + transactions\n\nreplication.factor = 3      min.insync.replicas = 2\nretention.ms = 604800000    (7 days)\nnum.partitions = parallelism limit for consumers\n\nRule of thumb: consumers in one group <= partitions.",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "acks=0     fire and forget (fastest, can lose data)\nacks=1     leader confirms (lost if leader dies first)\nacks=all   every in-sync replica confirms (safest)\n\nAt-most-once    commit the offset BEFORE processing\nAt-least-once   commit AFTER processing (the default).\n                Duplicates possible: make handlers idempotent.\nExactly-once    idempotent producer + transactions\n\nreplication.factor = 3      min.insync.replicas = 2\nretention.ms = 604800000    (7 days)\nnum.partitions = parallelism limit for consumers\n\nRule of thumb: consumers in one group <= partitions.",
      "autoResize": true,
      "lineHeight": 1.2
    }
  ],
