    },
    {
      "id": "lH8ZDrc8qVe_nCyubQhTz",
      "type": "text",
      "x": 1544,
      "y": 2640,
      "width": 308.03173828125,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0a",
      "roundness": null,
      "seed": 683701469,
      "version": 3,
      "versionNonce": 2123445853,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795582754626,
      "link": null,
      "locked": false,
      "text": "• One local broker means replication\n  factor 1. Production uses 3+ brokers.\n• Max useful consumers in one group =\n  number of partitions (extras sit idle).\n• Make handlers idempotent: after a\n  crash an event can be delivered twice.\n• Never put secrets in event values.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• One local broker means replication\n  factor 1. Production uses 3+ brokers.\n• Max useful consumers in one group =\n  number of partitions (extras sit idle).\n• Make handlers idempotent: after a\n  crash an event can be delivered twice.\n• Never put secrets in event values.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_uT4DWLVB6Y3zW6jR-NHA",
      "type": "text",
      "x": 51.07208251953125,
      "y": 1680,
      "width": 187.8558349609375,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0b",
      "roundness": null,
      "seed": 676219901,
      "version": 4,
      "versionNonce": 1460251123,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795582754626,
      "link": null,
      "locked": false,
      "text": "1  Producer builds event\n(key, value, headers)\nand serializes it",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "w1",
      "originalText": "1  Producer builds event\n(key, value, headers)\nand serializes it",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9PN5ckDSt2ck_cZ5mr8e1",
      "type": "text",
      "x": 415.06407928466797,
      "y": 1680,
      "width": 179.87184143066406,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0c",
      "roundness": null,
      "seed": 2147337309,
      "version": 4,
      "versionNonce": 926180029,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795582754626,
      "link": null,
      "locked": false,
      "text": "2  Pick the partition\nhash(key) % partitions\n(no key: round-robin)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "w2",
      "originalText": "2  Pick the partition\nhash(key) % partitions\n(no key: round-robin)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1uU7ZR5x-jeDCY6u1iMd9",
      "type": "text",
      "x": 770.0400848388672,
      "y": 1680,
      "width": 189.91983032226562,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0d",
      "roundness": null,
      "seed": 937373885,
      "version": 4,
      "versionNonce": 1321595795,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795582754626,
      "link": null,
      "locked": false,
      "text": "3  Send to the LEADER\nbroker of that partition\n(batched for speed)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "w3",
      "originalText": "3  Send to the LEADER\nbroker of that partition\n(batched for speed)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BfSwN12sbRUCn0iKguWxW",
      "type": "text",
      "x": 1127.808090209961,
      "y": 1680,
      "width": 194.38381958007812,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0e",
      "roundness": null,
      "seed": 1569984797,
      "version": 4,
      "versionNonce": 1601372957,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795582754626,
      "link": null,
      "locked": false,
      "text": "4  Leader appends to its\nlog; followers copy it\n(replication)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "w4",
      "originalText": "4  Leader appends to its\nlog; followers copy it\n(replication)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IQFHJ6gMbiXVULH6kFn7_",
      "type": "text",
      "x": 1472.1920928955078,
      "y": 1680,
      "width": 225.61581420898438,
      "height": 60,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0f",
      "roundness": null,
      "seed": 1317922173,
      "version": 4,
      "versionNonce": 1200097587,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795582754626,
      "link": null,
      "locked": false,
      "text": "5  Leader ACKs the producer\nacks=all: after all in-sync\nreplicas have the event",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "w5",
      "originalText": "5  Leader ACKs the producer\nacks=all: after all in-sync\nreplicas have the event",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "053glvm5FY2z9j6WQqSTR",
      "type": "text",
      "x": 46.16809844970703,
      "y": 1880,
      "width": 197.66380310058594,
      "height": 60,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0g",
      "roundness": null,
      "seed": 969720029,
      "version": 4,
      "versionNonce": 1539217277,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795582754626,
      "link": null,
      "locked": false,
      "text": "1  Consumer joins a group\nBroker assigns it some\npartitions (rebalance)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "r1",
      "originalText": "1  Consumer joins a group\nBroker assigns it some\npartitions (rebalance)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xrBq-5IwtKV4NPqJKYjzN",
